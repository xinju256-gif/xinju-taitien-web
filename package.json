    "@types/node": "22.19.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
